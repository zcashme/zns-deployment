#!/usr/bin/env bash
# The service-pair choice, without QEMU.
set -euo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=hops.sh
source "$HERE/hops.sh"

fail=0
check() {
  local net="$1" role="$2" held_m="$3" held_z="$4" busy="$5" want="$6" label="$7"
  local got err
  ZNS_NETWORK="$net"
  unset ZNS_MINT_FWD ZNS_ZEBRA_FWD
  if ! got="$(choose_ports "$role" "$held_m" "$held_z" "$busy" 2>/dev/null)"; then
    got="fail"
  fi
  got="${got%%$'\n'*}"
  if [[ "$got" != "$want" ]]; then
    echo "fail: ${label}: got ${got}, want ${want}" >&2
    fail=1
  fi
}

check_fail() {
  local net="$1" role="$2" held_m="$3" held_z="$4" busy="$5" label="$6"
  ZNS_NETWORK="$net"
  unset ZNS_MINT_FWD ZNS_ZEBRA_FWD
  if choose_ports "$role" "$held_m" "$held_z" "$busy" >/dev/null 2>&1; then
    echo "fail: ${label}: expected a refusal" >&2
    fail=1
  fi
}

check testnet genesis "" "" "" "10465 10999" "testnet genesis takes the low pair"
check testnet target "10465" "10999" "10465 10999" "20465 20999" "testnet moves to the high pair"
check testnet target "20465" "20999" "20465 20999" "10465 10999" "testnet moves back to the low pair"
check testnet target "19465" "19999" "19465 19999" "10465 10999" "a foreign pair stays off testnet"
check mainnet target "19465" "19999" "19465 19999" "9465 9999" "mainnet moves back to the low pair"
check mainnet target "9465" "9999" "9465 9999" "19465 19999" "mainnet moves to the high pair"
check mainnet genesis "" "" "9465 9999" "19465 19999" "genesis uses the high pair when the low pair is taken"
check testnet backup "" "" "" "30465 30999" "testnet backup keeps its pair"
check mainnet backup "" "" "" "29465 29999" "mainnet backup keeps its pair"
check_fail testnet target "10465" "10999" "10465 10999 20465 20999" "both testnet pairs taken"
check_fail mainnet backup "" "" "29465 29999" "mainnet backup pair taken"

ZNS_NETWORK=testnet
ZNS_MINT_FWD=21065
ZNS_ZEBRA_FWD=21999
got="$(choose_ports target "" "" "" 2>/dev/null)"
if [[ "${got%%$'\n'*}" != "21065 21999" || "$got" != *$'\n''testnet, from the environment' ]]; then
  echo "fail: environment pair: got ${got}" >&2
  fail=1
fi
if choose_ports target "" "" "21065" >/dev/null 2>&1; then
  echo "fail: environment pair already forwarded" >&2
  fail=1
fi
unset ZNS_ZEBRA_FWD
if choose_ports target "" "" "" >/dev/null 2>&1; then
  echo "fail: one environment port" >&2
  fail=1
fi
unset ZNS_MINT_FWD

line="qemu-system-x86_64 -netdev user,id=net0,hostfwd=tcp:127.0.0.1:20465-:9465,hostfwd=tcp:127.0.0.1:20999-:9998 -name zns-testnet-v2.1.0 -nographic"
got="$(parse_forward_ports "$line")"
if [[ "$got" != "20465 20999" ]]; then
  echo "fail: parse forwards: got ${got}" >&2
  fail=1
fi

ZNS_NETWORK=testnet
got="$(choose_ports target 19465 19999 "19465 19999" 2>/dev/null)"
if [[ "$got" != *$'\n''testnet low pair; live guest holds 19465/19999, outside this network' ]]; then
  echo "fail: reason line: got ${got}" >&2
  fail=1
fi

dir="$(mktemp -d)"
write_host_ports "$dir" v0.1.0 genesis 10465 10999 "testnet low pair"
write_host_ports "$dir" v0.1.0 genesis 10465 10999 "testnet low pair"
write_host_ports "$dir" v0.1.0 genesis 10465 10999 "already running"
write_host_ports "$dir" v0.1.0 target 20465 20999 "testnet high pair; live guest holds 10465/10999"
write_host_ports "$dir" v0.2.0 target 20465 20999 "already running"
write_host_ports "$dir" v0.2.0 target 20465 20999 "already running"
got="$(cat "$dir/logs/v0.1.0.ports")"
want=$'genesis 10465 10999 testnet low pair\ngenesis 10465 10999 testnet low pair\ntarget 20465 20999 testnet high pair; live guest holds 10465/10999'
if [[ "$got" != "$want" ]]; then
  echo "fail: ports record: got ${got}" >&2
  fail=1
fi
got="$(cat "$dir/logs/v0.2.0.ports")"
want=$'target 20465 20999 already running'
if [[ "$got" != "$want" ]]; then
  echo "fail: ports record: got ${got}" >&2
  fail=1
fi
rm -rf "$dir"

got="$(switch_line zns-testnet-target zns-testnet-source "mint 20465 zebra 20999")"
want="Switched from zns-testnet-target to zns-testnet-source in tmux. Host ports mint 20465 zebra 20999."
if [[ "$got" != "$want" ]]; then
  echo "fail: switch line: got ${got}" >&2
  fail=1
fi
got="$(switch_line zns-testnet-source zns-testnet-previous "")"
want="Switched from zns-testnet-source to zns-testnet-previous in tmux."
if [[ "$got" != "$want" ]]; then
  echo "fail: switch line without ports: got ${got}" >&2
  fail=1
fi

if [[ "$fail" -ne 0 ]]; then
  exit 1
fi
echo "host port pairs ok"
