#!/usr/bin/env bash
# Download one release into the hops directory and verify it before accepting.
#
#   sudo ZNS_NETWORK=testnet ./launch/fetch-release v0.1.x
#
# ZNS_NETWORK selects $ZNS_HOPS/<network>. Downloads that network's files,
# zns-<network>-*. Writes them without the prefix under
# $ZNS_HOPS/<network>/images/<tag>/release/: zns-initrd.img, snp-measurement.txt,
# release-manifest.json, and, when the release has them for this network,
# the upgrade document and the same-release backup document. Each document
# is upgrade.toml or backup.toml, the .bin beside it, and the attestation
# bundle.
# Does not boot a guest and does not publish those files into a live
# upgrade directory.
#
# Each file must be attested by this repo's release workflow on that tag.
# The manifest must name this network, the measurement, and the initrd's
# hash. Each document's toml must match its .bin, and its artifact_hash
# and to_measurement must be this initrd and measurement. A backup
# document's two measurements are equal.
# Files already on disk are reused only when each one has the SHA-256 the
# release publishes now, and they are verified again the same way.
set -euo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=hops.sh
source "$HERE/hops.sh"

ZNS_REPO="${ZNS_REPO:-zcashme/zns-deployment}"
SIGNER_WORKFLOW=".github/workflows/release.yml"

if [[ "$#" -ne 1 ]]; then
  echo "usage: fetch-release <v*-tag>" >&2
  exit 1
fi

tag="$1"
require_tag "$tag"
require_root

for cmd in gh python3; do
  if ! command -v "$cmd" >/dev/null; then
    echo "missing $cmd" >&2
    exit 1
  fi
done
if ! operator_gh attestation verify --help >/dev/null 2>&1; then
  echo "gh attestation verify is required" >&2
  exit 1
fi

hops="$(hops_root)" || exit 1
network="$(hops_network "$hops")" || exit 1
prefix="zns-${network}-"
release_dir="$hops/images/${tag}/release"
mkdir -p "$release_dir"

# Published name, then the name on this host.
required=(
  "${prefix}initrd.img zns-initrd.img"
  "${prefix}snp-measurement.txt snp-measurement.txt"
  "${prefix}release-manifest.json release-manifest.json"
)
upgrade=(
  "${prefix}upgrade.bin upgrade.bin"
  "${prefix}upgrade.toml upgrade.toml"
)
backup=(
  "${prefix}backup.bin backup.bin"
  "${prefix}backup.toml backup.toml"
)

attest() {
  local path="$1" out="$2" identity
  identity="https://github.com/${ZNS_REPO}/${SIGNER_WORKFLOW}@refs/tags/${tag}"
  operator_gh attestation verify "$path" \
    --repo "$ZNS_REPO" \
    --source-ref "refs/tags/${tag}" \
    --cert-identity "$identity" \
    --format json >"$out"
}

verify_release() {
  # The cache check calls this inside an if, where set -e does not apply, so
  # every step returns on failure itself.
  local dir="$1" with_upgrade="$2" with_backup="$3" path verified
  for path in "$dir/zns-initrd.img" "$dir/snp-measurement.txt" "$dir/release-manifest.json"; do
    if [[ -L "$path" || ! -f "$path" ]]; then
      echo "missing release file $path" >&2
      return 1
    fi
  done
  if [[ "$with_upgrade" -eq 1 ]]; then
    for path in "$dir/upgrade.bin" "$dir/upgrade.toml"; do
      if [[ -L "$path" || ! -f "$path" ]]; then
        echo "missing release file $path" >&2
        return 1
      fi
    done
  fi
  if [[ "$with_backup" -eq 1 ]]; then
    for path in "$dir/backup.bin" "$dir/backup.toml"; do
      if [[ -L "$path" || ! -f "$path" ]]; then
        echo "missing release file $path" >&2
        return 1
      fi
    done
  fi
  if [[ -n "${SUDO_USER:-}" && "$SUDO_USER" != "root" ]]; then
    chmod a+rx "$dir" || return 1
    chmod a+r "$dir"/* || return 1
  fi
  verified="$(mktemp -d)" || return 1
  if ! attest "$dir/zns-initrd.img" "$verified/initrd.json" ||
    ! attest "$dir/snp-measurement.txt" "$verified/measurement.json" ||
    ! attest "$dir/release-manifest.json" "$verified/manifest.json"; then
    rm -rf "$verified"
    return 1
  fi
  if [[ "$with_upgrade" -eq 1 ]] && ! attest "$dir/upgrade.bin" "$verified/upgrade.json"; then
    rm -rf "$verified"
    return 1
  fi
  if [[ "$with_backup" -eq 1 ]] && ! attest "$dir/backup.bin" "$verified/backup.json"; then
    rm -rf "$verified"
    return 1
  fi
  if ! python3 - "$dir" "$tag" "$network" "$with_upgrade" "$verified/upgrade.json" "$dir/upgrade.bundle.jsonl" "$with_backup" "$verified/backup.json" <<'PY'
import hashlib, json, pathlib, struct, sys, tomllib

directory, tag, network, with_upgrade, verified_path, bundle_path, with_backup, backup_verified = sys.argv[1:]
root = pathlib.Path(directory)
initrd = (root / "zns-initrd.img").read_bytes()
initrd_sha = hashlib.sha256(initrd).digest()
measurement = (root / "snp-measurement.txt").read_text().strip()
manifest = json.loads((root / "release-manifest.json").read_text())

if manifest.get("network") != network:
    raise SystemExit(f"release manifest network is {manifest.get('network')!r}, this host is {network}")
if manifest.get("tee_measurement") != measurement:
    raise SystemExit("release manifest tee_measurement does not match snp-measurement.txt")
initrd_name = f"zns-{network}-initrd.img"
listed = [a for a in manifest.get("artifacts", []) if a.get("name") == initrd_name]
if len(listed) != 1 or listed[0].get("sha256") != initrd_sha.hex():
    raise SystemExit(f"release manifest does not list this {initrd_name}")

def check_document(bin_name, toml_name, verified_file, bundle_out, same_release):
    blob = (root / bin_name).read_bytes()
    file = tomllib.loads((root / toml_name).read_text())
    keys = {
        "version",
        "sequence",
        "from_measurement",
        "to_measurement",
        "from_guest_policy",
        "to_guest_policy",
        "seed_fingerprint",
        "source_capsule_hash",
        "artifact_hash",
        "release",
    }
    if set(file) != keys:
        raise SystemExit(f"{toml_name} fields do not match the upgrade document")
    if file["version"] != 1:
        raise SystemExit(f"{toml_name} version is not 1")
    if type(file["sequence"]) is not int or file["sequence"] < 0:
        raise SystemExit(f"{toml_name} sequence is not an integer")

    def hex_field(name, size):
        raw = str(file[name]).strip().removeprefix("0x")
        try:
            data = bytes.fromhex(raw)
        except ValueError:
            raise SystemExit(f"{toml_name} {name} is not hex")
        if len(data) != size or not any(data):
            raise SystemExit(f"{toml_name} {name} must be {size} nonzero bytes")
        return data

    def policy(name):
        value = file[name]
        if type(value) is not int or value <= 0:
            raise SystemExit(f"{toml_name} {name} must be a nonzero integer")
        return value

    release = file["release"]
    if release != tag:
        raise SystemExit(f"{bin_name} release is {release}, expected {tag}")
    from_measurement = hex_field("from_measurement", 48)
    to_measurement = hex_field("to_measurement", 48)
    if same_release and from_measurement != to_measurement:
        raise SystemExit("backup document from_measurement and to_measurement differ")
    body = bytearray()
    body += struct.pack("<I", 1)
    body += struct.pack("<Q", file["sequence"])
    body += from_measurement
    body += to_measurement
    body += struct.pack("<Q", policy("from_guest_policy"))
    body += struct.pack("<Q", policy("to_guest_policy"))
    body += hex_field("seed_fingerprint", 32)
    body += hex_field("source_capsule_hash", 32)
    artifact = hex_field("artifact_hash", 32)
    body += artifact
    encoded = release.encode()
    body += struct.pack("<I", len(encoded))
    body += encoded
    if bytes(body) != blob:
        raise SystemExit(f"{toml_name} does not match the attested {bin_name}")
    if initrd_sha != artifact:
        raise SystemExit(f"zns-initrd.img does not match the attested artifact_hash in {toml_name}")
    if to_measurement.hex() != measurement:
        raise SystemExit(f"{toml_name} to_measurement does not match snp-measurement.txt")
    verified = json.loads(pathlib.Path(verified_file).read_text())
    if len(verified) != 1 or "attestation" not in verified[0]:
        raise SystemExit("gh attestation verify did not return the signed bundle")
    bundle = verified[0]["attestation"]["bundle"]
    pathlib.Path(bundle_out).write_text(json.dumps(bundle, separators=(",", ":")) + "\n")

if with_upgrade == "1":
    check_document("upgrade.bin", "upgrade.toml", verified_path, bundle_path, False)
if with_backup == "1":
    check_document("backup.bin", "backup.toml", backup_verified, root / "backup.bundle.jsonl", True)
PY
  then
    rm -rf "$verified"
    return 1
  fi
  rm -rf "$verified"
}

# One line per published file: name, then its sha256.
published="$(operator_gh release view "$tag" -R "$ZNS_REPO" --json assets \
  --jq '.assets[] | .name + " " + ((.digest // "") | ltrimstr("sha256:"))')"
has_asset() {
  awk -v n="$1" '$1 == n { found = 1 } END { exit !found }' <<<"$published"
}
published_sha() {
  awk -v n="$1" '$1 == n { print $2; exit }' <<<"$published"
}

for entry in "${required[@]}"; do
  if ! has_asset "${entry%% *}"; then
    echo "release $tag has no ${entry%% *}" >&2
    exit 1
  fi
done
with_upgrade=0
if has_asset "${upgrade[0]%% *}" || has_asset "${upgrade[1]%% *}"; then
  for entry in "${upgrade[@]}"; do
    if ! has_asset "${entry%% *}"; then
      echo "release $tag has no ${entry%% *}" >&2
      exit 1
    fi
  done
  with_upgrade=1
fi
with_backup=0
if has_asset "${backup[0]%% *}" || has_asset "${backup[1]%% *}"; then
  for entry in "${backup[@]}"; do
    if ! has_asset "${entry%% *}"; then
      echo "release $tag has no ${entry%% *}" >&2
      exit 1
    fi
  done
  with_backup=1
fi

files=("${required[@]}")
if [[ "$with_upgrade" -eq 1 ]]; then
  files+=("${upgrade[@]}")
fi
if [[ "$with_backup" -eq 1 ]]; then
  files+=("${backup[@]}")
fi

# The workflow can run again on a tag and replace or add files, so a file on
# disk is reused only when it has the hash the release publishes now.
cache_matches() {
  local entry local_path want got
  for entry in "${files[@]}"; do
    local_path="$release_dir/${entry#* }"
    want="$(published_sha "${entry%% *}")"
    [[ -n "$want" && -s "$local_path" && ! -L "$local_path" ]] || return 1
    got="$(sha256sum "$local_path" | awk '{ print $1 }')"
    [[ "$got" == "$want" ]] || return 1
  done
  if [[ "$with_upgrade" -eq 0 && -e "$release_dir/upgrade.bin" ]]; then
    return 1
  fi
  if [[ "$with_backup" -eq 0 && -e "$release_dir/backup.bin" ]]; then
    return 1
  fi
}

if cache_matches && verify_release "$release_dir" "$with_upgrade" "$with_backup"; then
  echo "${network} release files already in $release_dir"
  exit 0
fi

tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT
if [[ -n "${SUDO_USER:-}" && "$SUDO_USER" != "root" ]]; then
  chown "$SUDO_USER" "$tmp"
fi
patterns=()
for entry in "${files[@]}"; do
  patterns+=(-p "${entry%% *}")
done
operator_gh release download "$tag" -R "$ZNS_REPO" "${patterns[@]}" -D "$tmp"
for entry in "${files[@]}"; do
  mv "$tmp/${entry%% *}" "$tmp/${entry#* }"
done
if ! verify_release "$tmp" "$with_upgrade" "$with_backup"; then
  echo "release $tag did not verify for $network" >&2
  exit 1
fi

install_file() {
  cp "$tmp/$1" "$release_dir/$1.partial"
  mv "$release_dir/$1.partial" "$release_dir/$1"
}
rm -f "$release_dir/upgrade.bin" "$release_dir/upgrade.toml" "$release_dir/upgrade.bundle.jsonl"
rm -f "$release_dir/backup.bin" "$release_dir/backup.toml" "$release_dir/backup.bundle.jsonl"
install_file zns-initrd.img
install_file snp-measurement.txt
install_file release-manifest.json
if [[ "$with_upgrade" -eq 1 ]]; then
  install_file upgrade.toml
  install_file upgrade.bundle.jsonl
  install_file upgrade.bin
fi
if [[ "$with_backup" -eq 1 ]]; then
  install_file backup.toml
  install_file backup.bundle.jsonl
  install_file backup.bin
fi
trap - EXIT
rm -rf "$tmp"
note="fetched $tag for $network into $release_dir"
if [[ "$with_upgrade" -eq 1 ]]; then
  note="$note with its upgrade document"
fi
if [[ "$with_backup" -eq 1 ]]; then
  note="$note with its backup document"
fi
echo "$note"
