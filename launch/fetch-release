#!/usr/bin/env bash
# Download one release into the hops directory and verify it before accepting.
#
#   sudo ./launch/fetch-release v0.1.x
#
# Takes this host's network from $ZNS_HOPS/network and downloads that
# network's files, zns-<network>-*. Writes them without the prefix under
# $ZNS_HOPS/images/<tag>/release/: zns-initrd.img, snp-measurement.txt,
# release-manifest.json, and, when the release has an upgrade document for
# this network, upgrade.toml, upgrade.bin, and the attestation bundle.
# Does not boot a guest and does not publish those files into a live
# upgrade directory.
#
# Each file must be attested by this repo's release workflow on that tag.
# The manifest must name this network, the measurement, and the initrd's
# hash. upgrade.toml must be the same document as upgrade.bin, and its
# artifact_hash and to_measurement must be this initrd and measurement.
# Files already on disk are checked the same way.
set -euo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=hops.sh
source "$HERE/hops.sh"

ZNS_REPO="${ZNS_REPO:-zcashme/zns-deployment}"
SIGNER_WORKFLOW=".github/workflows/release.yml"

if [[ "$#" -ne 1 ]]; then
  echo "usage: fetch-release <v*-tag>" >&2
  exit 1
fi

tag="$1"
require_tag "$tag"
require_root

for cmd in gh python3; do
  if ! command -v "$cmd" >/dev/null; then
    echo "missing $cmd" >&2
    exit 1
  fi
done
if ! operator_gh attestation verify --help >/dev/null 2>&1; then
  echo "gh attestation verify is required" >&2
  exit 1
fi

hops="$(hops_root)"
network="$(hops_network "$hops")"
prefix="zns-${network}-"
release_dir="$hops/images/${tag}/release"
mkdir -p "$release_dir"

# Published name, then the name on this host.
required=(
  "${prefix}initrd.img zns-initrd.img"
  "${prefix}snp-measurement.txt snp-measurement.txt"
  "${prefix}release-manifest.json release-manifest.json"
)
upgrade=(
  "${prefix}upgrade.bin upgrade.bin"
  "${prefix}upgrade.toml upgrade.toml"
)

attest() {
  local path="$1" out="$2" identity
  identity="https://github.com/${ZNS_REPO}/${SIGNER_WORKFLOW}@refs/tags/${tag}"
  operator_gh attestation verify "$path" \
    --repo "$ZNS_REPO" \
    --source-ref "refs/tags/${tag}" \
    --cert-identity "$identity" \
    --format json >"$out"
}

verify_release() {
  local dir="$1" with_upgrade="$2" path verified
  for path in "$dir/zns-initrd.img" "$dir/snp-measurement.txt" "$dir/release-manifest.json"; do
    if [[ -L "$path" || ! -f "$path" ]]; then
      echo "missing release file $path" >&2
      exit 1
    fi
  done
  if [[ "$with_upgrade" -eq 1 ]]; then
    for path in "$dir/upgrade.bin" "$dir/upgrade.toml"; do
      if [[ -L "$path" || ! -f "$path" ]]; then
        echo "missing release file $path" >&2
        exit 1
      fi
    done
  fi
  if [[ -n "${SUDO_USER:-}" && "$SUDO_USER" != "root" ]]; then
    chmod a+rx "$dir"
    chmod a+r "$dir"/*
  fi
  verified="$(mktemp -d)"
  attest "$dir/zns-initrd.img" "$verified/initrd.json"
  attest "$dir/snp-measurement.txt" "$verified/measurement.json"
  attest "$dir/release-manifest.json" "$verified/manifest.json"
  if [[ "$with_upgrade" -eq 1 ]]; then
    attest "$dir/upgrade.bin" "$verified/upgrade.json"
  fi
  python3 - "$dir" "$tag" "$network" "$with_upgrade" "$verified/upgrade.json" "$dir/upgrade.bundle.jsonl" <<'PY'
import hashlib, json, pathlib, struct, sys, tomllib

directory, tag, network, with_upgrade, verified_path, bundle_path = sys.argv[1:]
root = pathlib.Path(directory)
initrd = (root / "zns-initrd.img").read_bytes()
initrd_sha = hashlib.sha256(initrd).digest()
measurement = (root / "snp-measurement.txt").read_text().strip()
manifest = json.loads((root / "release-manifest.json").read_text())

if manifest.get("network") != network:
    raise SystemExit(f"release manifest network is {manifest.get('network')!r}, this host is {network}")
if manifest.get("tee_measurement") != measurement:
    raise SystemExit("release manifest tee_measurement does not match snp-measurement.txt")
initrd_name = f"zns-{network}-initrd.img"
listed = [a for a in manifest.get("artifacts", []) if a.get("name") == initrd_name]
if len(listed) != 1 or listed[0].get("sha256") != initrd_sha.hex():
    raise SystemExit(f"release manifest does not list this {initrd_name}")

if with_upgrade != "1":
    sys.exit(0)

blob = (root / "upgrade.bin").read_bytes()
file = tomllib.loads((root / "upgrade.toml").read_text())
keys = {
    "version",
    "sequence",
    "from_measurement",
    "to_measurement",
    "from_guest_policy",
    "to_guest_policy",
    "seed_fingerprint",
    "source_capsule_hash",
    "artifact_hash",
    "release",
}
if set(file) != keys:
    raise SystemExit("upgrade.toml fields do not match the upgrade document")
if file["version"] != 1:
    raise SystemExit("upgrade.toml version is not 1")
if type(file["sequence"]) is not int or file["sequence"] < 0:
    raise SystemExit("upgrade.toml sequence is not an integer")

def hex_field(name, size):
    raw = str(file[name]).strip().removeprefix("0x")
    try:
        data = bytes.fromhex(raw)
    except ValueError:
        raise SystemExit(f"upgrade.toml {name} is not hex")
    if len(data) != size or not any(data):
        raise SystemExit(f"upgrade.toml {name} must be {size} nonzero bytes")
    return data

def policy(name):
    value = file[name]
    if type(value) is not int or value <= 0:
        raise SystemExit(f"upgrade.toml {name} must be a nonzero integer")
    return value

release = file["release"]
if release != tag:
    raise SystemExit(f"upgrade document release is {release}, expected {tag}")
body = bytearray()
body += struct.pack("<I", 1)
body += struct.pack("<Q", file["sequence"])
body += hex_field("from_measurement", 48)
to_measurement = hex_field("to_measurement", 48)
body += to_measurement
body += struct.pack("<Q", policy("from_guest_policy"))
body += struct.pack("<Q", policy("to_guest_policy"))
body += hex_field("seed_fingerprint", 32)
body += hex_field("source_capsule_hash", 32)
artifact = hex_field("artifact_hash", 32)
body += artifact
encoded = release.encode()
body += struct.pack("<I", len(encoded))
body += encoded
if bytes(body) != blob:
    raise SystemExit("upgrade.toml does not match the attested upgrade.bin")
if initrd_sha != artifact:
    raise SystemExit("zns-initrd.img does not match the attested artifact_hash")
if to_measurement.hex() != measurement:
    raise SystemExit("upgrade document to_measurement does not match snp-measurement.txt")
verified = json.loads(pathlib.Path(verified_path).read_text())
if len(verified) != 1 or "attestation" not in verified[0]:
    raise SystemExit("gh attestation verify did not return the signed bundle")
bundle = verified[0]["attestation"]["bundle"]
path = pathlib.Path(bundle_path)
path.write_text(json.dumps(bundle, separators=(",", ":")) + "\n")
PY
  rm -rf "$verified"
}

assets_ready() {
  local entry
  for entry in "${required[@]}"; do
    [[ ! -L "$release_dir/${entry#* }" && -s "$release_dir/${entry#* }" ]] || return 1
  done
}

published="$(operator_gh release view "$tag" -R "$ZNS_REPO" --json assets --jq '.assets[].name')"
has_asset() {
  grep -qxF -- "$1" <<<"$published"
}

# A release can gain an upgrade document after the first fetch, when the
# workflow runs again on the tag. Files on disk count only if they include it.
cached_upgrade=0
if [[ -s "$release_dir/upgrade.bin" ]]; then
  cached_upgrade=1
fi
if [[ "$cached_upgrade" -eq 1 ]] || ! has_asset "${upgrade[0]%% *}"; then
  if assets_ready && ( verify_release "$release_dir" "$cached_upgrade" ); then
    echo "${network} release files already in $release_dir"
    exit 0
  fi
fi
for entry in "${required[@]}"; do
  if ! has_asset "${entry%% *}"; then
    echo "release $tag has no ${entry%% *}" >&2
    exit 1
  fi
done
with_upgrade=0
if has_asset "${upgrade[0]%% *}" || has_asset "${upgrade[1]%% *}"; then
  for entry in "${upgrade[@]}"; do
    if ! has_asset "${entry%% *}"; then
      echo "release $tag has no ${entry%% *}" >&2
      exit 1
    fi
  done
  with_upgrade=1
fi

tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT
if [[ -n "${SUDO_USER:-}" && "$SUDO_USER" != "root" ]]; then
  chown "$SUDO_USER" "$tmp"
fi
files=("${required[@]}")
if [[ "$with_upgrade" -eq 1 ]]; then
  files+=("${upgrade[@]}")
fi
patterns=()
for entry in "${files[@]}"; do
  patterns+=(-p "${entry%% *}")
done
operator_gh release download "$tag" -R "$ZNS_REPO" "${patterns[@]}" -D "$tmp"
for entry in "${files[@]}"; do
  mv "$tmp/${entry%% *}" "$tmp/${entry#* }"
done
verify_release "$tmp" "$with_upgrade"

install_file() {
  cp "$tmp/$1" "$release_dir/$1.partial"
  mv "$release_dir/$1.partial" "$release_dir/$1"
}
rm -f "$release_dir/upgrade.bin" "$release_dir/upgrade.toml" "$release_dir/upgrade.bundle.jsonl"
install_file zns-initrd.img
install_file snp-measurement.txt
install_file release-manifest.json
if [[ "$with_upgrade" -eq 1 ]]; then
  install_file upgrade.toml
  install_file upgrade.bundle.jsonl
  install_file upgrade.bin
fi
trap - EXIT
rm -rf "$tmp"
if [[ "$with_upgrade" -eq 1 ]]; then
  echo "fetched $tag for $network with its upgrade document into $release_dir"
else
  echo "fetched $tag for $network into $release_dir; this release has no upgrade document for $network"
fi
