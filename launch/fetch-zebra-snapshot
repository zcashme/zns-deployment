#!/usr/bin/env bash
# Download a Zebra chain snapshot this guest can open.
#
#   sudo ZNS_NETWORK=testnet ./launch/fetch-zebra-snapshot
#
# Reads https://snapshots.zfnd.org/<network>/snapshots.json for ZNS_NETWORK
# and keeps the newest archive whose db_major is zebra_db_format or
# zebra_db_format_previous in versions.toml. A newer database format is not
# downloaded. The file is stored under $ZNS_HOPS/<network>/snapshots/. A
# later run downloads again when that choice or its
# checksum changes. The archive can be deleted once a Zebra disk built
# from it is syncing; the disk image is the working copy.
set -euo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=hops.sh
source "$HERE/hops.sh"

ROOT="$(cd "$HERE/.." && pwd)"

if [[ "$#" -ne 0 ]]; then
  echo "usage: fetch-zebra-snapshot" >&2
  exit 1
fi

require_root

for cmd in curl python3 sha256sum; do
  if ! command -v "$cmd" >/dev/null; then
    echo "missing $cmd" >&2
    exit 1
  fi
done

hops="$(hops_root)"
network="$(hops_network "$hops")"
db_format="$(grep -E '^zebra_db_format[[:space:]]*=' "$ROOT/versions.toml" | head -n 1 || true)"
db_format="${db_format#*=}"
db_format="${db_format//\"/}"
db_format="${db_format//[[:space:]]/}"
if [[ ! "$db_format" =~ ^[0-9]+$ ]]; then
  echo "versions.toml has no zebra_db_format" >&2
  exit 1
fi
db_previous="$(grep -E '^zebra_db_format_previous[[:space:]]*=' "$ROOT/versions.toml" | head -n 1 || true)"
db_previous="${db_previous#*=}"
db_previous="${db_previous//\"/}"
db_previous="${db_previous//[[:space:]]/}"
if [[ -n "$db_previous" && ! "$db_previous" =~ ^[0-9]+$ ]]; then
  echo "versions.toml zebra_db_format_previous is not a number" >&2
  exit 1
fi

snapdir="$hops/snapshots"
mkdir -p "$snapdir"
index="$snapdir/snapshots.json"
curl -fsSL -A zns-deployment -o "$index" "https://snapshots.zfnd.org/${network}/snapshots.json"

python3 - "$index" "$snapdir/latest" "$network" "$db_format" "$db_previous" <<'PY'
import json, pathlib, re, sys
index, dest, network, want, previous = sys.argv[1:]
want = int(want)
allowed = {want}
if previous:
    allowed.add(int(previous))
rows = json.loads(pathlib.Path(index).read_text())
compatible = [
    row for row in rows
    if row.get("network") == network and row.get("db_major") in allowed
]
if not compatible:
    names = ", ".join(str(item) for item in sorted(allowed))
    raise SystemExit(
        f"no {network} snapshot uses database format {names}; not creating a Zebra disk"
    )
chosen = max(
    compatible,
    key=lambda row: (row.get("height") or 0, 1 if row.get("db_major") == want else 0),
)
name = chosen.get("filename")
if not isinstance(name, str) or re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._-]*", name) is None:
    raise SystemExit("snapshot filename is not a single name")
lines = [
    f"filename={name}",
    f"url={chosen['url']}",
    f"sha256={chosen['sha256']}",
    f"height={chosen['height']}",
    f"db_major={chosen['db_major']}",
    f"size={chosen.get('size', '')}",
]
pathlib.Path(dest).write_text("\n".join(lines) + "\n")
PY

filename="$(grep '^filename=' "$snapdir/latest" | head -n 1)"
filename="${filename#filename=}"
require_snapshot_filename "$filename"
url="$(grep '^url=' "$snapdir/latest" | head -n 1)"
url="${url#url=}"
sha256="$(grep '^sha256=' "$snapdir/latest" | head -n 1)"
sha256="${sha256#sha256=}"
size="$(grep '^size=' "$snapdir/latest" | head -n 1)"
size="${size#size=}"
archive="$snapdir/$filename"

have=""
if [[ -f "$archive" ]]; then
  have="$(sha256sum "$archive" | awk '{print $1}')"
fi
if [[ "$have" != "$sha256" ]]; then
  echo "downloading $filename ($size)"
  curl -fL --retry 3 -A zns-deployment -o "$archive.partial" "$url"
  got="$(sha256sum "$archive.partial" | awk '{print $1}')"
  if [[ "$got" != "$sha256" ]]; then
    rm -f "$archive.partial"
    echo "snapshot checksum does not match the published manifest" >&2
    exit 1
  fi
  mv "$archive.partial" "$archive"
fi

echo "snapshot: $archive"
echo "height: $(grep '^height=' "$snapdir/latest" | head -n 1 | cut -d= -f2-)"
