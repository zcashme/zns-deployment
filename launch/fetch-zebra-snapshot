#!/usr/bin/env bash
# Download the latest Zebra chain snapshot for this guest's network.
#
#   sudo ./launch/fetch-zebra-snapshot
#
# Reads https://snapshots.zfnd.org/<network>/snapshots.json and keeps the
# archive whose roles include "latest". The file is stored under
# $ZNS_HOPS/snapshots/. A later run downloads again when that latest name
# or checksum changes. The archive can be deleted once a Zebra disk built
# from it is syncing; the disk image is the working copy.
set -euo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=hops.sh
source "$HERE/hops.sh"

ROOT="$(cd "$HERE/.." && pwd)"

if [[ "$#" -ne 0 ]]; then
  echo "usage: fetch-zebra-snapshot" >&2
  exit 1
fi

require_root

for cmd in curl python3 sha256sum; do
  if ! command -v "$cmd" >/dev/null; then
    echo "missing $cmd" >&2
    exit 1
  fi
done

network="$(grep -E '^network[[:space:]]*=' "$ROOT/versions.toml" | head -n 1 || true)"
network="${network#*=}"
network="${network//\"/}"
network="${network//[[:space:]]/}"
if [[ -z "$network" ]]; then
  echo "versions.toml has no network" >&2
  exit 1
fi

hops="$(hops_root)"
snapdir="$hops/snapshots"
mkdir -p "$snapdir"
index="$snapdir/snapshots.json"
curl -fsSL -A zns-deployment -o "$index" "https://snapshots.zfnd.org/${network}/snapshots.json"

python3 - "$index" "$snapdir/latest" "$network" <<'PY'
import json, pathlib, sys
index, dest, network = sys.argv[1:]
rows = json.loads(pathlib.Path(index).read_text())
latest = next((row for row in rows if "latest" in row.get("roles", [])), None)
if latest is None:
    raise SystemExit("no snapshot is marked latest")
if latest.get("network") != network:
    raise SystemExit(f"snapshot network {latest.get('network')} != {network}")
major = latest.get("db_major")
if major not in (28, 29):
    raise SystemExit(f"snapshot database format {major} is not usable by this guest")
lines = [
    f"filename={latest['filename']}",
    f"url={latest['url']}",
    f"sha256={latest['sha256']}",
    f"height={latest['height']}",
    f"db_major={major}",
    f"size={latest.get('size', '')}",
]
pathlib.Path(dest).write_text("\n".join(lines) + "\n")
PY

filename="$(grep '^filename=' "$snapdir/latest" | head -n 1)"
filename="${filename#filename=}"
url="$(grep '^url=' "$snapdir/latest" | head -n 1)"
url="${url#url=}"
sha256="$(grep '^sha256=' "$snapdir/latest" | head -n 1)"
sha256="${sha256#sha256=}"
size="$(grep '^size=' "$snapdir/latest" | head -n 1)"
size="${size#size=}"
archive="$snapdir/$filename"

have=""
if [[ -f "$archive" ]]; then
  have="$(sha256sum "$archive" | awk '{print $1}')"
fi
if [[ "$have" != "$sha256" ]]; then
  echo "downloading $filename ($size)"
  curl -fL --retry 3 -A zns-deployment -o "$archive.partial" "$url"
  got="$(sha256sum "$archive.partial" | awk '{print $1}')"
  if [[ "$got" != "$sha256" ]]; then
    rm -f "$archive.partial"
    echo "snapshot checksum does not match the published manifest" >&2
    exit 1
  fi
  mv "$archive.partial" "$archive"
fi

echo "snapshot: $archive"
echo "height: $(grep '^height=' "$snapdir/latest" | head -n 1 | cut -d= -f2-)"
