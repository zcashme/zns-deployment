#!/bin/sh
# Guest init. This script is PID 1.
# Mount the two state disks, get an address by DHCP, then run the ceremony.
# zns-supervise keeps Zebra, mint, and the metrics forwarder running.
# Logs live under /state/log and stay on the state disk across a QEMU restart.
# 9p tags upgrade and transport are the live hop. upgrade-next means this boot
# is a migration target; it does not run keygen.
set -eu

ZEBRA_CONFIG="/etc/zebra/zebrad.toml"
STATE_DIR="/state"
SUP_PID=""
KEYGEN_PID=""
PARAMS_DIR="/root/.zcash-params"

log() {
  echo "[zns] $*"
}

fatal() {
  log "FATAL: $*"

  # PID 1 on the serial console is the host's keyboard. A shell here would be
  # root in the measured guest. Stop the guest. This BusyBox has reboot and
  # not poweroff. QEMU is started with -no-reboot, so reboot exits QEMU.
  # If both return, exiting PID 1 panics the kernel and still does not start
  # a shell.
  if [ "$$" -eq 1 ]; then
    log "stopping"
    if [ -w /proc/sysrq-trigger ]; then
      echo 1 > /proc/sys/kernel/sysrq 2>/dev/null || true
      echo o > /proc/sysrq-trigger 2>/dev/null || true
    fi
    reboot -f 2>/dev/null || true
  fi

  exit 1
}

# QEMU is started with -no-reboot, so reboot exits QEMU. This BusyBox has
# reboot and not poweroff.
stop_guest() {
  sync || true
  log "stopping"
  if [ -w /proc/sysrq-trigger ]; then
    echo 1 > /proc/sys/kernel/sysrq 2>/dev/null || true
    echo o > /proc/sysrq-trigger 2>/dev/null || true
  fi
  reboot -f 2>/dev/null || true
}

export HOME=/root
export ZCASH_PARAMS_DIR="$PARAMS_DIR"
export PATH=/usr/local/bin:/sbin:/usr/sbin:/bin:/usr/bin

mkdir -p /proc /sys /dev /run /var/lib/zebra /state /etc /tmp /root || fatal "could not create directories"

mount -t tmpfs tmpfs /run 2>/dev/null || true

/usr/bin/busybox mount -t devtmpfs devtmpfs /dev ||
  fatal "failed to mount devtmpfs on /dev"

/usr/bin/busybox mount -t proc proc /proc ||
  fatal "failed to mount proc on /proc"

/usr/bin/busybox mount -t sysfs sysfs /sys ||
  fatal "failed to mount sysfs on /sys"

/usr/bin/insmod /lib/modules/$(uname -r)/kernel/drivers/virt/coco/guest/tsm_report.ko.zst ||
  fatal "failed to load tsm_report"

/usr/bin/insmod /lib/modules/$(uname -r)/kernel/drivers/virt/coco/sev-guest/sev-guest.ko.zst ||
  fatal "failed to load sev-guest"

[ -e /dev/sev-guest ] ||
  fatal "/dev/sev-guest is unavailable"

log "resolving persistent volumes"

ZNS_DEV=/dev/vda
ZEBRA_DEV=/dev/vdb

[ -b "$ZNS_DEV" ] || fatal "$ZNS_DEV is unavailable"
[ -b "$ZEBRA_DEV" ] || fatal "$ZEBRA_DEV is unavailable"

log "mounting ZNS state from $ZNS_DEV"
mount "$ZNS_DEV" /state || fatal "could not mount ZNS state from $ZNS_DEV"

log "mounting Zebra state from $ZEBRA_DEV"
mount "$ZEBRA_DEV" /var/lib/zebra || fatal "could not mount Zebra state from $ZEBRA_DEV"

mkdir -p "$STATE_DIR/log" || fatal "could not create $STATE_DIR/log"

ip link set lo up || fatal "could not bring up lo"

NIC=""
for iface in /sys/class/net/*; do
  name="${iface##*/}"
  if [ "$name" != "lo" ]; then
    NIC="$name"
    break
  fi
done

if [ -z "$NIC" ]; then
  fatal "no network interface found"
fi

log "using network interface $NIC"
ip link set "$NIC" up || fatal "could not bring up $NIC"

log "requesting DHCP lease"
dhcp_ok=0
for _try in 1 2 3; do
  if ipconfig -c dhcp -t 30 "$NIC"; then
    dhcp_ok=1
    break
  fi
  log "DHCP attempt ${_try} failed"
  sleep 5 || fatal "sleep failed"
done
[ "$dhcp_ok" -eq 1 ] || fatal "DHCP failed on $NIC"

NETCONF="/run/net-${NIC}.conf"
if [ ! -f "$NETCONF" ]; then
  fatal "DHCP succeeded but $NETCONF was not created"
fi

# shellcheck disable=SC1090
. "$NETCONF" || fatal "could not read $NETCONF"

log "guest IPv4: ${IPV4ADDR:-unknown}"
log "gateway: ${IPV4GATEWAY:-unknown}"

: > /etc/resolv.conf || fatal "could not write /etc/resolv.conf"
for dns in "${IPV4DNS0:-}" "${IPV4DNS1:-}"; do
  if [ -n "$dns" ] && [ "$dns" != "0.0.0.0" ]; then
    echo "nameserver $dns" >> /etc/resolv.conf || fatal "could not write /etc/resolv.conf"
  fi
done

if [ ! -s /etc/resolv.conf ]; then
  fatal "DHCP supplied no usable DNS servers"
fi

if [ ! -f "$PARAMS_DIR/sapling-spend.params" ] || [ ! -f "$PARAMS_DIR/sapling-output.params" ]; then
  fatal "Sapling params are missing from $PARAMS_DIR"
fi

if [ ! -f "$ZEBRA_CONFIG" ]; then
  fatal "Zebra config not found at $ZEBRA_CONFIG"
fi

indexer_addr="127.0.0.1:8230"
if grep -q '^network = "Testnet"' "$ZEBRA_CONFIG"; then
  indexer_addr="127.0.0.1:18230"
fi
if ! grep -q "indexer_listen_addr = \"$indexer_addr\"" "$ZEBRA_CONFIG"; then
  fatal "Zebra gRPC listener $indexer_addr is not configured"
fi

# kill -0 reports a zombie as alive. State Z in /proc means the process has exited.
alive() {
  pid="$1"
  [ -n "$pid" ] || return 1
  [ -r "/proc/$pid/status" ] || return 1
  line="$(grep '^State:' "/proc/$pid/status" 2>/dev/null || true)"
  [ -n "$line" ] || return 1
  rest="${line#State:}"
  while [ "${rest# }" != "$rest" ]; do
    rest="${rest# }"
  done
  while [ "${rest#	}" != "$rest" ]; do
    rest="${rest#	}"
  done
  [ "${rest%"${rest#?}"}" != "Z" ]
}

start_supervisor() {
  # /run/backup-stopping is set once a same-release backup has the capsule.
  # The supervisor stays down until this guest powers off.
  if [ -f /run/backup-stopping ]; then
    return
  fi
  if alive "$SUP_PID"; then
    return
  fi
  if [ -n "$SUP_PID" ]; then
    wait "$SUP_PID" || true
  fi
  log "starting supervisor"
  /usr/local/bin/zns-supervise >>"$STATE_DIR/log/supervisor.log" 2>&1 &
  SUP_PID=$!
  printf '%s\n' "$SUP_PID" >/run/supervisor.pid || true
  if [ -f /run/backup-stopping ]; then
    kill -9 "$SUP_PID" 2>/dev/null || true
    SUP_PID=""
  fi
}

watch_supervisor() {
  if alive "$SUP_PID"; then
    return
  fi
  if [ -n "$SUP_PID" ]; then
    wait "$SUP_PID" || true
    log "supervisor exited, restarting"
  fi
  SUP_PID=""
  start_supervisor
}

print_access_code_key() {
  # One line per boot. The public key is derived from the seed, so a later
  # boot prints the same line. stdout is the hex key. Tracing stays in the log.
  key="$(zns-keygen access-code 2>>"$STATE_DIR/log/keygen.log")" ||
    fatal "could not derive the access-code public key"
  case "$key" in
    *[!0-9a-f]*|"") fatal "access-code public key was not hex" ;;
  esac
  [ "${#key}" -eq 64 ] || fatal "access-code public key was not 64 hex characters"
  log "access-code public key: $key"
}

start_keygen() {
  : >"$KEYGEN_EXIT" || fatal "could not write $KEYGEN_EXIT"
  # set -e would skip writing the exit status when keygen fails.
  (
    set +e
    zns-keygen >>"$STATE_DIR/log/keygen.log" 2>&1
    echo $? >"$KEYGEN_EXIT"
  ) &
  KEYGEN_PID=$!
}

load_9p() {
  kver="$(uname -r)"
  base="/lib/modules/$kver"
  /usr/bin/insmod "$base/kernel/fs/netfs/netfs.ko.zst" || fatal "failed to load netfs"
  /usr/bin/insmod "$base/kernel/net/9p/9pnet.ko.zst" || fatal "failed to load 9pnet"
  /usr/bin/insmod "$base/kernel/fs/9p/9p.ko.zst" || fatal "failed to load 9p"
  /usr/bin/insmod "$base/kernel/net/9p/9pnet_virtio.ko.zst" || fatal "failed to load 9pnet_virtio"
  sleep 1 || fatal "sleep failed"
}

mount_one_9p() {
  tag="$1"
  dest="$2"
  mode="$3"
  mkdir -p "$dest" || fatal "could not create $dest"
  opts="trans=virtio,version=9p2000.L,cache=none"
  if [ "$mode" = "ro" ]; then
    opts="$opts,ro"
  fi
  mount -t 9p -o "$opts" "$tag" "$dest" || fatal "could not mount $tag on $dest"
  log "mounted $tag on $dest"
}

mount_9p() {
  load_9p
  for dev in /sys/bus/virtio/devices/virtio*; do
    [ -e "$dev/mount_tag" ] || continue
    tag=""
    IFS= read -r tag <"$dev/mount_tag" || true
    while [ "${tag# }" != "$tag" ]; do
      tag="${tag# }"
    done
    while [ "${tag% }" != "$tag" ]; do
      tag="${tag% }"
    done
    case "$tag" in
      upgrade) mount_one_9p "$tag" /upgrade ro ;;
      transport) mount_one_9p "$tag" /migration rw ;;
      upgrade-next) mount_one_9p "$tag" /upgrade-next ro ;;
      transport-next) mount_one_9p "$tag" /migration-next rw ;;
    esac
  done
}

channel_has() {
  dir="$1"
  shift
  name=""
  for name in "$@"; do
    if [ -e "$dir/$name" ]; then
      return 0
    fi
  done
  return 1
}

upgrade_ready() {
  dir="$1"
  [ -f "$dir/upgrade.toml" ] && [ -f "$dir/upgrade.bin" ] && [ -f "$dir/upgrade.bundle.jsonl" ]
}

artifact_line() {
  grep '^artifact_hash ' "$1/upgrade.toml" 2>/dev/null || true
}

# The source done line is the sequence, both measurements, and the artifact
# hash. A same-release backup is another line for the same initrd.
document_line() {
  dir="$1"
  seq=$(grep '^sequence = ' "$dir/upgrade.toml" 2>/dev/null || true)
  from=$(grep '^from_measurement = ' "$dir/upgrade.toml" 2>/dev/null || true)
  to=$(grep '^to_measurement = ' "$dir/upgrade.toml" 2>/dev/null || true)
  art=$(grep '^artifact_hash = ' "$dir/upgrade.toml" 2>/dev/null || true)
  if [ -z "$seq" ] || [ -z "$from" ] || [ -z "$to" ] || [ -z "$art" ]; then
    return 0
  fi
  printf '%s|%s|%s|%s\n' "$seq" "$from" "$to" "$art"
}

# zns-migrate and the same-release decision both read this copy.
# The 9p directory stays writable by the host.
stage_document() {
  src="$1"
  rm -rf /run/zns-upgrade
  mkdir -p /run/zns-upgrade || return 1
  cp "$src/upgrade.toml" /run/zns-upgrade/upgrade.toml || return 1
  cp "$src/upgrade.bundle.jsonl" /run/zns-upgrade/upgrade.bundle.jsonl || return 1
  cp "$src/upgrade.bin" /run/zns-upgrade/upgrade.bin || return 1
}

same_release() {
  toml="$1"
  from_line=$(grep '^from_measurement = "' "$toml" 2>/dev/null || true)
  to_line=$(grep '^to_measurement = "' "$toml" 2>/dev/null || true)
  from=${from_line#*\"}
  from=${from%\"}
  to=${to_line#*\"}
  to=${to%\"}
  [ -n "$from" ] && [ "$from" = "$to" ]
}

# A finished same-release backup leaves the hold file absent. The done file
# can already be in place while the hold file is still there. The two
# measurements stored in that done line decide. The upgrade directory is
# not read again.
clear_recorded_backup_hold() {
  line=""
  [ -f "$STATE_DIR/migrate-source.done" ] || return 0
  IFS= read -r line <"$STATE_DIR/migrate-source.done" || return 0
  oldifs=$IFS
  IFS='|'
  set -f
  set -- $line
  set +f
  IFS=$oldifs
  from=""
  to=""
  part=""
  for part in "$@"; do
    case "$part" in
      'from_measurement = "'*)
        from=${part#*\"}
        from=${from%\"}
        ;;
      'to_measurement = "'*)
        to=${part#*\"}
        to=${to%\"}
        ;;
    esac
  done
  [ -n "$from" ] && [ "$from" = "$to" ] || return 0
  [ -f "$STATE_DIR/migrate-source.hold" ] || return 0
  rm -f "$STATE_DIR/migrate-source.hold" || return 1
  log "same-release backup accepted; mint hold cleared"
}

# The supervisor is stopped before the hold file is removed. The disk that
# remains has no hold file. A later boot of this release opens the capsule.
# /run/backup-stopping is set first, and the supervisor treats that file as
# a hold, so mint stays down across the removal.
stop_pids() {
  pids="$(pidof "$1" 2>/dev/null || true)"
  if [ -n "$pids" ]; then
    kill -9 $pids 2>/dev/null || true
  fi
}

finish_backup() {
  printf 'stopping\n' >/run/backup-stopping || return 1
  stop_pids zns-supervise
  stop_pids zns-supervise
  stop_pids zns-mint
  rm -f "$STATE_DIR/migrate-source.hold" || return 1
  sync || true
  stop_pids zns-supervise
  stop_pids zns-mint
  stop_guest
}

# Power off only after the hold file is gone. Stopping earlier leaves the
# hold on the disk, and the next boot of this release would stay dark.
await_backup_poweroff() {
  ticks=0
  while [ ! -f /run/backup-stopping ] || [ -f "$STATE_DIR/migrate-source.hold" ]; do
    ticks=$((ticks + 1))
    if [ $((ticks % 30)) -eq 0 ]; then
      log "backup capsule is sealed; waiting to power off"
    fi
    sleep 1 || true
  done
  stop_guest
}

ceremony_complete() {
  # The custody manifest is the completion record: keygen writes it at
  # finalize, and a migration target installs it beside the capsule.
  [ -s "$STATE_DIR/keys/zns_custody_manifest.toml" ]
}

source_allowed() {
  [ -f "$STATE_DIR/keys/zns_seed.capsule" ] || return 1
  if ceremony_complete; then
    return 0
  fi
  [ -f "$STATE_DIR/migrate-target.done" ]
}

already_done() {
  line="$1"
  [ -n "$line" ] || return 1
  [ -f "$STATE_DIR/migrate-source.done" ] || return 1
  done_line=""
  IFS= read -r done_line <"$STATE_DIR/migrate-source.done" || true
  [ "$done_line" = "$line" ]
}

# After a handoff to another release this mint serves until the target
# writes target.ready. That file is not attested: a forged one only stops
# this mint early. The hold stays for good, then zns-migrate attests it.
cutover_source() {
  [ -f "$STATE_DIR/migrate-source.cutover" ] && return 0
  [ -f "$1/target.ready" ] || return 0
  if [ ! -f "$STATE_DIR/migrate-source.hold" ]; then
    printf 'hold\n' >"$STATE_DIR/migrate-source.hold" || return
    log "target is ready; stopping this mint for good"
  fi
  # The supervisor checks the hold file every 30s.
  sleep 31 || return
  if pidof zns-mint >/dev/null 2>&1; then
    return
  fi
  /usr/local/bin/zns-migrate cutover source \
    --manifest /run/zns-upgrade/upgrade.toml \
    --upgrade-document /run/zns-upgrade/upgrade.bin \
    --attestation-bundle /run/zns-upgrade/upgrade.bundle.jsonl \
    --transport-dir "$1" >>"$STATE_DIR/log/migrate.log" 2>&1 || return
  printf 'cutover\n' >"$STATE_DIR/migrate-source.cutover" || return
  log "this mint is stopped for good; the target mint can run"
}

# A target that took the seed from another release keeps its hold until
# zns-migrate has checked the source's attested stop.
cutover_target() {
  grep -q ' /upgrade-next ' /proc/mounts || return 0
  [ -f "$STATE_DIR/migrate-target.done" ] || return 0
  [ -f "$STATE_DIR/migrate-target.cutover" ] && return 0
  stage_document /upgrade || return 1
  same_release /run/zns-upgrade/upgrade.toml && return 0
  http_ok http://127.0.0.1:8080/ready || return 1
  if [ ! -f /migration/target.ready ]; then
    printf 'ready\n' >/migration/target.ready || return 1
    log "zebra is ready; asking the previous mint to stop"
  fi
  /usr/local/bin/zns-migrate cutover target \
    --manifest /run/zns-upgrade/upgrade.toml \
    --upgrade-document /run/zns-upgrade/upgrade.bin \
    --attestation-bundle /run/zns-upgrade/upgrade.bundle.jsonl \
    --transport-dir /migration \
    --timeout-secs 86400 >>"$STATE_DIR/log/migrate.log" 2>&1 || return 1
  rm -f "$STATE_DIR/migrate-source.hold" || return 1
  printf 'cutover\n' >"$STATE_DIR/migrate-target.cutover" || return 1
  log "previous mint is stopped; this mint can run"
}

watch_target() {
  if [ "$target_wait" -eq 1 ]; then
    if channel_has /migration offer.bin attestation.bin encrypted_seed.bin \
      source_attestation.bin receipt.bin receipt_attestation.bin \
      target.ready source_stopped_attestation.bin \
      zns_custody_manifest.toml; then
      return
    fi
    target_wait=0
    log "migration transport is empty; target can try again"
  fi
  upgrade_ready /upgrade || return
  stage_document /upgrade || return
  artifact="$(artifact_line /run/zns-upgrade)"
  [ -n "$artifact" ] || return
  # zns-migrate target waits for source.ready and reads that file when it is
  # already present. That file alone is this attempt. Any other channel file
  # is a previous attempt.
  if channel_has /migration offer.bin attestation.bin encrypted_seed.bin \
    source_attestation.bin receipt.bin receipt_attestation.bin \
    target.ready source_stopped_attestation.bin \
    zns_custody_manifest.toml; then
    log "migration transport is not empty; target is waiting for it to be cleared"
    target_wait=1
    return
  fi
  mkdir -p "$STATE_DIR/keys" || return
  # A same-release target is a backup. /run/backup-target tells the parent
  # init this boot must not derive the access-code key and must power off
  # after the capsule lands.
  if same_release /run/zns-upgrade/upgrade.toml; then
    printf 'backup\n' >/run/backup-target || return
  fi
  # The hold is in place before the capsule is installed. A backup removes
  # it before powering off. Otherwise cutover_target removes it.
  printf 'hold\n' >"$STATE_DIR/migrate-source.hold" || return
  log "running zns-migrate target"
  /usr/local/bin/zns-migrate target \
    --manifest /run/zns-upgrade/upgrade.toml \
    --upgrade-document /run/zns-upgrade/upgrade.bin \
    --attestation-bundle /run/zns-upgrade/upgrade.bundle.jsonl \
    --transport-dir /migration \
    --output-capsule "$STATE_DIR/keys/zns_seed.capsule" \
    --timeout-secs 86400 >>"$STATE_DIR/log/migrate.log" 2>&1
  status=$?
  if [ "$status" -eq 0 ]; then
    printf '%s\n' "$artifact" >"$STATE_DIR/migrate-target.done" || true
    log "migration target finished"
  fi
  # A same-release target is a backup. Once the capsule is on this disk the
  # guest stops. A later boot of this release opens that capsule.
  if same_release /run/zns-upgrade/upgrade.toml \
    && [ -f "$STATE_DIR/keys/zns_seed.capsule" ]; then
    if [ "$status" -ne 0 ]; then
      log "migration target failed ($status); the capsule is sealed, stopping"
    fi
    finish_backup
    return
  fi
  if [ "$status" -eq 0 ]; then
    return
  fi
  log "migration target failed ($status); waiting for an empty transport directory"
  target_wait=1
}

watch_source() {
  if grep -q ' /upgrade-next ' /proc/mounts; then
    sup=/upgrade-next
    strn=/migration-next
  else
    sup=/upgrade
    strn=/migration
  fi
  if [ "$source_wait" -eq 1 ]; then
    if channel_has "$strn" source.ready offer.bin attestation.bin encrypted_seed.bin \
      source_attestation.bin receipt.bin receipt_attestation.bin \
      target.ready source_stopped_attestation.bin \
      zns_custody_manifest.toml; then
      return
    fi
    source_wait=0
    log "migration transport is empty; source can try again"
  fi
  if ! source_allowed; then
    if upgrade_ready "$sup" && [ "$told_ceremony" -eq 0 ]; then
      log "migration source waiting until this guest can hand off the capsule"
      told_ceremony=1
    fi
    return
  fi
  upgrade_ready "$sup" || return
  stage_document "$sup" || return
  identity="$(document_line /run/zns-upgrade)"
  [ -n "$identity" ] || return
  if already_done "$identity"; then
    if same_release /run/zns-upgrade/upgrade.toml; then
      clear_recorded_backup_hold || return
    else
      cutover_source "$strn" || return
    fi
    return
  fi
  if channel_has "$strn" source.ready offer.bin attestation.bin encrypted_seed.bin \
    source_attestation.bin receipt.bin receipt_attestation.bin \
    target.ready source_stopped_attestation.bin \
    zns_custody_manifest.toml; then
    log "migration transport is not empty; source is waiting for it to be cleared"
    source_wait=1
    return
  fi
  # A backup stops mint for the handoff. A move to another release does not:
  # the target's hold keeps its mint off until cutover_source stops this one.
  if same_release /run/zns-upgrade/upgrade.toml; then
    printf 'hold\n' >"$STATE_DIR/migrate-source.hold" || return
    # The supervisor checks the hold file every 30s. Wait out one pass so mint
    # is stopped before the capsule is read.
    sleep 31 || return
    if pidof zns-mint >/dev/null 2>&1; then
      log "mint still running; migration will wait"
      return
    fi
  fi
  log "running zns-migrate source"
  /usr/local/bin/zns-migrate source \
    --manifest /run/zns-upgrade/upgrade.toml \
    --upgrade-document /run/zns-upgrade/upgrade.bin \
    --attestation-bundle /run/zns-upgrade/upgrade.bundle.jsonl \
    --transport-dir "$strn" \
    --input-capsule "$STATE_DIR/keys/zns_seed.capsule" \
    --timeout-secs 86400 >>"$STATE_DIR/log/migrate.log" 2>&1
  status=$?
  if [ "$status" -eq 0 ]; then
    printf '%s\n' "$identity" >"$STATE_DIR/migrate-source.done.new" || return
    mv "$STATE_DIR/migrate-source.done.new" "$STATE_DIR/migrate-source.done" || return
    if same_release /run/zns-upgrade/upgrade.toml; then
      clear_recorded_backup_hold || return
      log "migration source finished"
      return
    fi
    log "seed is on the target; this mint serves while that guest syncs"
    return
  fi
  rm -f "$STATE_DIR/migrate-source.hold" || true
  log "migration source failed ($status); waiting for an empty transport directory"
  source_wait=1
}

migrate_watch() {
  if ! grep -q ' /upgrade ' /proc/mounts; then
    log "no upgrade mount; migration watch idle"
    return
  fi
  log "migration watch started"
  source_wait=0
  target_wait=0
  told_ceremony=0
  while true; do
    # Once a backup capsule is sealed, this boot only powers off. The source
    # watch reads /upgrade-next, and that directory must not start a handoff.
    if [ -f /run/backup-stopping ]; then
      sleep 5 || true
      continue
    fi
    if grep -q ' /upgrade-next ' /proc/mounts && [ ! -f "$STATE_DIR/keys/zns_seed.capsule" ]; then
      watch_target || true
    else
      if cutover_target; then
        watch_source || true
      fi
    fi
    sleep 5 || true
  done
}

http_ok() {
  wget -q -O /dev/null "$1" 2>/dev/null
}

# One integer from a Prometheus text file. $2 is the metric name after dots
# have been turned into underscores.
metric_int() {
  metric_file="$1"
  metric_name="$2"
  metric_got=""
  metric_line=""
  if [ ! -f "$metric_file" ]; then
    return
  fi
  while IFS= read -r metric_line || [ -n "$metric_line" ]; do
    case "$metric_line" in
      "$metric_name "*)
        metric_got="${metric_line#"$metric_name "}"
        metric_got="${metric_got%%[!0-9]*}"
        ;;
    esac
  done <"$metric_file"
  printf '%s' "$metric_got"
}

# $1 is kibibytes. Prints 512K, 3.4M, or 6.2G.
kib_human() {
  n="$1"
  case "$n" in
    ''|*[!0-9]*)
      printf 'unknown'
      return
      ;;
  esac
  if [ "$n" -ge 1048576 ]; then
    div=1048576
    unit=G
  elif [ "$n" -ge 1024 ]; then
    div=1024
    unit=M
  else
    printf '%sK' "$n"
    return
  fi
  whole=$((n / div))
  frac=$(((n % div) * 10 / div))
  printf '%s.%s%s' "$whole" "$frac" "$unit"
}

# $1 is a MemTotal-style key. The value is kibibytes.
mem_kb() {
  mem_key="$1"
  mem_got=""
  mem_line=""
  if [ ! -r /proc/meminfo ]; then
    return
  fi
  while IFS= read -r mem_line || [ -n "$mem_line" ]; do
    case "$mem_line" in
      "${mem_key}:"*)
        set -f
        set -- $mem_line
        set +f
        if [ "$#" -ge 2 ]; then
          mem_got="$2"
        fi
        ;;
    esac
  done </proc/meminfo
  printf '%s' "$mem_got"
}

# $1 is the label, $2 is the mount. df -k is 1024-byte blocks.
disk_phrase() {
  label="$1"
  mnt="$2"
  text=""
  text="$(df -k -P "$mnt" 2>/dev/null)" || {
    printf '%s disk unknown' "$label"
    return
  }
  row=""
  line=""
  while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in
      Filesystem*|'') continue ;;
    esac
    row="$line"
  done <<EOF
$text
EOF
  set -f
  set -- $row
  set +f
  if [ "$#" -lt 6 ] || [ -z "${2:-}" ] || [ -z "${4:-}" ]; then
    printf '%s disk unknown' "$label"
    return
  fi
  printf '%s disk %s free of %s' "$label" "$(kib_human "$4")" "$(kib_human "$2")"
}

release_notice() {
  rel=""
  if [ ! -s /etc/zns-release ]; then
    return
  fi
  read -r rel </etc/zns-release || return
  if [ -z "$rel" ]; then
    return
  fi
  while true; do
    if http_ok http://127.0.0.1:8080/healthy; then
      if http_ok http://127.0.0.1:8080/ready; then
        zebra_line="Zebra is healthy and ready"
      else
        zebra_line="Zebra is healthy and still syncing"
      fi
    else
      zebra_line="Zebra is not up"
    fi
    block=""
    if wget -q -O /tmp/zns-zebra-metrics http://127.0.0.1:9999/metrics 2>/dev/null; then
      # zcash.chain.verified.block.height, the latest block this Zebra has verified.
      block="$(metric_int /tmp/zns-zebra-metrics zcash_chain_verified_block_height)"
    fi
    if http_ok http://127.0.0.1:9464/metrics; then
      mint_line="Mint is up"
      if [ -z "$block" ] && wget -q -O /tmp/zns-mint-metrics http://127.0.0.1:9464/metrics 2>/dev/null; then
        block="$(metric_int /tmp/zns-mint-metrics zns_mint_chain_tip_height)"
      fi
    else
      mint_line="Mint is not up"
    fi
    if [ -z "$block" ]; then
      block="unknown"
    fi
    mem_total="$(mem_kb MemTotal)"
    mem_avail="$(mem_kb MemAvailable)"
    if [ -n "$mem_total" ] && [ -n "$mem_avail" ]; then
      mem_line="Memory $(kib_human "$mem_avail") available of $(kib_human "$mem_total")."
    else
      mem_line="Memory unknown."
    fi
    echo "You are running the ${rel} release of the ZNS protocol"
    echo "${zebra_line}. Latest Zcash block ${block}. ${mint_line}."
    echo "$mem_line"
    echo "$(disk_phrase ZNS /state). $(disk_phrase Zebra /var/lib/zebra)."
    sleep 600 || return
  done
}

mount_9p
start_supervisor
(
  set +e
  migrate_watch
) &
(
  set +e
  release_notice
) &

log "waiting for Zebra readiness on http://127.0.0.1:8080/ready"
attempt=0
last_err=""
while ! wget -O /dev/null http://127.0.0.1:8080/ready 2>/tmp/zebra-ready.err; do
  attempt=$((attempt + 1))
  err="$(tail -n 1 /tmp/zebra-ready.err 2>/dev/null || true)"
  if [ "$attempt" -eq 1 ] || [ "$err" != "$last_err" ] || [ $((attempt % 12)) -eq 0 ]; then
    case "$err" in
      *503*) why="zebra is up and still syncing" ;;
      *"can't connect"*|*"Connection refused"*) why="zebra is not listening" ;;
      *) why="${err:-no response}" ;;
    esac
    zebra_line="$(tail -n 1 "$STATE_DIR/log/zebra.log" 2>/dev/null || true)"
    sup_line="$(tail -n 1 "$STATE_DIR/log/supervisor.log" 2>/dev/null || true)"
    log "zebra is not ready (try ${attempt}): ${why}"
    log "zebra.log: ${zebra_line:-empty}"
    log "supervisor.log: ${sup_line:-empty}"
    last_err="$err"
  fi
  if [ -f /run/backup-stopping ] && [ ! -f "$STATE_DIR/migrate-source.hold" ]; then
    stop_guest
  fi
  watch_supervisor
  sleep 5 || fatal "sleep failed"
done
log "Zebra is ready"

cd "$STATE_DIR" || fatal "could not enter $STATE_DIR"
KEYGEN_EXIT="$STATE_DIR/log/keygen.exit"

if grep -q ' /upgrade-next ' /proc/mounts; then
  log "migration target: not running keygen"
  target_ticks=0
  while [ ! -f "$STATE_DIR/migrate-target.done" ] && [ ! -f "$STATE_DIR/keys/zns_seed.capsule" ]; do
    target_ticks=$((target_ticks + 1))
    if [ $((target_ticks % 12)) -eq 0 ]; then
      log "waiting for migration"
    fi
    watch_supervisor
    sleep 5 || fatal "sleep failed"
  done
  log "migration target has the capsule"
else
log "running keygen"
log "keygen output is in $STATE_DIR/log/keygen.log"
start_keygen
retry_left=0
keygen_ticks=0
shown_addr=""

while true; do
  keygen_ticks=$((keygen_ticks + 1))
  # The Treasury address is public. Repeat it so the funding wait does not
  # scroll it off the serial console. Keygen logs it to keygen.log.
  addr="$(sed -n 's/^.*Treasury t-address: //p' "$STATE_DIR/log/keygen.log" 2>/dev/null | tail -n 1)"
  if [ -n "$addr" ]; then
    if [ "$addr" != "$shown_addr" ] || [ $((keygen_ticks % 12)) -eq 0 ]; then
      log "fund this address: $addr"
      shown_addr="$addr"
    fi
  fi
  if [ $((keygen_ticks % 12)) -eq 0 ]; then
    keygen_line="$(tail -n 1 "$STATE_DIR/log/keygen.log" 2>/dev/null || true)"
    log "keygen still running: ${keygen_line:-no log line yet}"
  fi
  watch_supervisor
  if [ -n "$KEYGEN_PID" ] && ! alive "$KEYGEN_PID"; then
    wait "$KEYGEN_PID" || true
    status=""
    read -r status <"$KEYGEN_EXIT" || status=""
    KEYGEN_PID=""
    if [ "$status" = "0" ]; then
      break
    fi
    log "keygen failed, retrying in 30s"
    retry_left=6
  fi
  if [ -z "$KEYGEN_PID" ]; then
    if [ "$retry_left" -gt 0 ]; then
      retry_left=$((retry_left - 1))
    else
      start_keygen
    fi
  fi
  sleep 5 || fatal "sleep failed"
done
log "ceremony complete"
fi

# A same-release backup has the capsule and then powers off. Deriving the
# access-code key opens that capsule on this boot.
if [ -f /run/backup-target ]; then
  await_backup_poweroff
  while true; do
    sleep 30 || true
  done
fi

print_access_code_key

log "supervisor pid $SUP_PID"
log "guest logs are in $STATE_DIR/log"
while true; do
  if [ -f /run/backup-stopping ]; then
    while [ -f "$STATE_DIR/migrate-source.hold" ]; do
      sleep 1 || true
    done
    stop_guest
    sleep 5 || true
    continue
  fi
  wait "$SUP_PID" || true
  log "supervisor exited, restarting"
  SUP_PID=""
  start_supervisor
done
